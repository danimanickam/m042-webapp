{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(docker --version)",
      "Bash(docker compose version)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(gh auth status)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sS http://localhost:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh repo create:*)",
      "Bash(gh secret:*)",
      "Bash(gh api:*)",
      "Bash(brew install:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose up:*)",
      "Bash(docker system prune:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
